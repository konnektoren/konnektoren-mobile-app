vendors_root := "vendors"
vendor_dir := "vendors/konnektoren_css"
konnektoren_dir := "../temp/konnektoren"
konnektoren_repo := "https://github.com/konnektoren/konnektoren-yew.git"

default:
    @just --list

# Install shared styles if the vendor copy is missing
setup-vendors:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{ vendor_dir }}/index.css" ]; then
        just clone-konnektoren
        just integrate-konnektoren
    fi

clone-konnektoren:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d "{{ konnektoren_dir }}" ]; then
        git clone --depth 1 "{{ konnektoren_repo }}" "{{ konnektoren_dir }}"
    fi

# Copy upstream styles into the vendor dir and (re)write the vendor entrypoint
integrate-konnektoren:
    mkdir -p "{{ vendor_dir }}"
    cp -R "{{ konnektoren_dir }}/styles/." "{{ vendor_dir }}/"
    printf '%s\n' '@import "./konnektoren_css/index.css";' > "{{ vendors_root }}/index.css"

# Fetch the latest upstream styles and replace the vendor copy
update-vendors: clone-konnektoren
    git -C "{{ konnektoren_dir }}" pull --ff-only
    rm -rf "{{ vendor_dir }}"
    just integrate-konnektoren

# Remove the downloaded source and generated vendor copy
clean-vendors:
    rm -rf "{{ konnektoren_dir }}" "{{ vendor_dir }}" "{{ vendors_root }}/index.css"

vendor-status:
    @if [ -f "{{ vendor_dir }}/index.css" ]; then echo "Konnektoren CSS: Installed"; else echo "Konnektoren CSS: Not installed"; fi
